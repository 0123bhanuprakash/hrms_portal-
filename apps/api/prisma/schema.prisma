/// Project activity: people added, milestones done, type changes…
model ProjectEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// created | type | status | member_added | member_updated | member_removed | milestone_added | milestone_done | milestone_reopened | update | role_opened | role_filled
  kind        String
  text        String
  /// type changes: the type from this moment on (CLIENT | INTERNAL)
  value       String?
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_events")
}

/// Company / department / location news
model Announcement {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  authorId          String?              @map("author_id") @db.Uuid
  title             String
  body              String
  audience          AnnouncementAudience @default(COMPANY)
  /// DEPARTMENTS: these departments and everything under them
  departmentIds     String[]             @default([]) @map("department_ids") @db.Uuid
  locationIds       String[]             @default([]) @map("location_ids") @db.Uuid
  pinned            Boolean              @default(false)
  /// Readers confirm "I have read this"
  requiresAck       Boolean              @default(false) @map("requires_ack")
  /// Chosen by the poster: also email the audience (in-app is always sent)
  sendEmail         Boolean              @default(false) @map("send_email")
  expiresAt         DateTime?            @map("expires_at")
  attachmentName    String?              @map("attachment_name")
  attachmentMime    String?              @map("attachment_mime")
  attachmentSize    Int?                 @map("attachment_size")
  attachmentKey     String?              @map("attachment_key")
  publishedAt       DateTime             @default(now()) @map("published_at")
  /// policy | event | celebrate | update | urgent
  category          String               @default("update")
  /// Cover preset (indigo, teal, sunset, sky, rose, slate) and its emoji
  cover             String?
  coverEmoji        String?              @map("cover_emoji")
  /// Animated scene: confetti | diyas | sparkles | aurora | snow | balloons | fireworks | rain
  coverScene        String?              @map("cover_scene")
  /// 3D art piece key (megaphone, calendar, trophy…)
  coverArt          String?              @map("cover_art")
  /// off | gentle | lively (a one-time burst when opened)
  coverMotion       String               @default("gentle") @map("cover_motion")
  /// Uploaded cover: public URL, kind (image | video | lottie), focal point (0–100) and darkening (0–70)
  coverMediaUrl     String?              @map("cover_media_url")
  coverMediaKind    String?              @map("cover_media_kind")
  coverFocusX       Int                  @default(50) @map("cover_focus_x")
  coverFocusY       Int                  @default(50) @map("cover_focus_y")
  coverDim          Int                  @default(25) @map("cover_dim")
  /// draft | scheduled | published (scheduled ones go out at publishedAt)
  status            String               @default("published")
  /// When the audience was told (null = not yet: draft or scheduled)
  notifiedAt        DateTime?            @map("notified_at")
  /// TEAM audience: the manager whose reporting line receives it
  teamManagerId     String?              @map("team_manager_id") @db.Uuid
  /// People @mentioned in the body (user ids) — told on publish, and if the post is deleted
  mentionIds        String[]             @default([]) @map("mention_ids") @db.Uuid
  /// Confirm by this day; a reminder goes 2 days before
  ackDueAt          DateTime?            @map("ack_due_at") @db.Date
  ackReminderSentAt DateTime?            @map("ack_reminder_sent_at")
  lastNudgedAt      DateTime?            @map("last_nudged_at")
  allowReactions    Boolean              @default(true) @map("allow_reactions")
  /// Events: when and where (RSVP going / maybe)
  eventAt           DateTime?            @map("event_at")
  eventPlace        String?              @map("event_place")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  author    User?                  @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads     AnnouncementRead[]
  reactions AnnouncementReaction[]
  rsvps     AnnouncementRsvp[]

  @@index([companyId, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId String    @map("announcement_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  readAt         DateTime  @default(now()) @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

model AnnouncementReaction {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  emoji          String
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId, emoji])
  @@map("announcement_reactions")
}

/// Event replies: going | maybe | no
model AnnouncementRsvp {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  response       String
  updatedAt      DateTime @updatedAt @map("updated_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_rsvps")
}

/// "Add my thanks" — colleagues backing someone else's kudos
model KudosThanks {
  kudosId   String   @map("kudos_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  kudos Kudos @relation(fields: [kudosId], references: [id], onDelete: Cascade)

  @@id([kudosId, userId])
  @@map("kudos_thanks")
}

/// Company values kudos can be tagged with (editable by HR)
model KudosValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  emoji       String
