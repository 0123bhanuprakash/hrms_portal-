  color       String   @default("#6366F1")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(100) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  kudos Kudos[]

  @@unique([companyId, name])
