model KudosRecipient {
  kudosId    String @map("kudos_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  kudos    Kudos    @relation(fields: [kudosId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([kudosId, employeeId])
  @@index([employeeId])
  @@map("kudos_recipients")
}

model KudosReaction {
  kudosId   String   @map("kudos_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  kudos Kudos @relation(fields: [kudosId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kudosId, userId, emoji])
  @@map("kudos_reactions")
}

/// Expense categories with limits (amounts in paise)
model ExpenseCategory {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                 String   @map("company_id") @db.Uuid
  name                      String
  description               String?
  /// Most one line item may claim (null = no limit)
  maxPerItemPaise           Int?     @map("max_per_item_paise")
  /// Receipt needed when an item is above this (0 = always, null = never)
  receiptRequiredAbovePaise Int?     @map("receipt_required_above_paise")
  /// Most one person may claim in a calendar month (null = no cap); going over needs a reason
  maxPerMonthPaise          Int?     @map("max_per_month_paise")
  isActive                  Boolean  @default(true) @map("is_active")
  sortOrder                 Int      @default(100) @map("sort_order")
  createdAt                 DateTime @default(now()) @map("created_at")

  items ExpenseItem[]

  @@unique([companyId, name])
  @@map("expense_categories")
}

/// One reimbursement claim with line items
model ExpenseClaim {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  employeeId       String             @map("employee_id") @db.Uuid
  title            String
  /// Optional: cost belongs to a project
  projectId        String?            @map("project_id") @db.Uuid
  status           ExpenseClaimStatus @default(DRAFT)
  /// Increases on every (re)submission; approvals belong to a round
  round            Int                @default(0)
  submittedAt      DateTime?          @map("submitted_at")
  approvedAt       DateTime?          @map("approved_at")
  rejectionReason  String?            @map("rejection_reason")
  paidAt           DateTime?          @map("paid_at")
  paidById         String?            @map("paid_by_id") @db.Uuid
  paymentDate      DateTime?          @map("payment_date") @db.Date
  paymentReference String?            @map("payment_reference")
  /// An approver asked a question that the employee hasn't answered yet (the asker's user id)
  questionOpenById String?            @map("question_open_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  employee  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items     ExpenseItem[]
  approvals ExpenseApproval[]
  comments  ExpenseComment[]

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@map("expense_claims")
}

model ExpenseItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId         String   @map("claim_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  date            DateTime @db.Date
  description     String
  amountPaise     Int      @map("amount_paise")
  /// Lowered by Finance / HR (null = the full amount); the lower decision wins
  approvedPaise   Int?     @map("approved_paise")
  adjustReason    String?  @map("adjust_reason")
  adjustedById    String?  @map("adjusted_by_id") @db.Uuid
  /// Why it goes over the category limit / monthly cap (allowed, flagged to approvers)
  overLimitReason String?  @map("over_limit_reason")
  receiptKey      String?  @map("receipt_key")
  receiptName     String?  @map("receipt_name")
  receiptMime     String?  @map("receipt_mime")
  receiptSize     Int?     @map("receipt_size")
  createdAt       DateTime @default(now()) @map("created_at")

  claim    ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([claimId])
  @@map("expense_items")
}

/// Questions and replies on a leave request — asking doesn't block approving
model LeaveComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveRequestId String   @map("leave_request_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  /// QUESTION (from an approver) | REPLY (from the employee)
  kind           String
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@map("leave_comments")
}

/// Questions and replies on a claim — asking doesn't send the claim back
model ExpenseComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId   String   @map("claim_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// QUESTION (from an approver) | REPLY (from the employee)
  kind      String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("expense_comments")
}

/// One approval step of one submission round
model ExpenseApproval {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId      String              @map("claim_id") @db.Uuid
  round        Int
  stage        ExpenseStage
  /// Manager step: everyone who may decide (team lead / PM / line manager)
  approverIds  String[]            @default([]) @map("approver_ids") @db.Uuid
  label        String?
  status       LeaveApprovalStatus @default(PENDING)
  actedById    String?             @map("acted_by_id") @db.Uuid
  onBehalfOfId String?             @map("on_behalf_of_id") @db.Uuid
  comments     String?
  actedAt      DateTime?           @map("acted_at")

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, round, stage])
  @@map("expense_approvals")
}

/// Kinds of assets (Laptop, Monitor, ID card…), editable by IT
model AssetType {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  name              String
  /// Prefix for generated tags, e.g. LAP → LAP-0001
  prefix            String
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(100) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  /// Picture / animation: laptop | monitor | phone | idcard | headset | keyboard | sim | box
  icon              String   @default("box")
  /// Shown in "Request something"
  description       String?
  /// Default warranty for new assets of this type
  warrantyMonths    Int?     @map("warranty_months")
  /// Flag assets older than this for a refresh
  replaceAfterYears Int?     @map("replace_after_years")
  /// Warn when fewer are available
  minStock          Int      @default(0) @map("min_stock")
  /// Employees can ask for it
  requestable       Boolean  @default(true)
  /// Can be lent for a while (with a return date)
  loanable          Boolean  @default(false)
  maxLoanDays       Int?     @map("max_loan_days")
  /// Extra fields kept per asset (Processor, Memory…)
  fields            String[] @default([])
  /// Ticked by IT at hand-over (Charger, sticker…)
  checklist         String[] @default([])

  assets   Asset[]
  requests AssetRequest[]

  @@unique([companyId, name])
  @@map("asset_types")
}

model Asset {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  typeId            String         @map("type_id") @db.Uuid
  /// Company asset tag, e.g. LAP-0007 (unique per company)
  tag               String
  name              String
  brand             String?
  model             String?
  serialNumber      String?        @map("serial_number")
  purchaseDate      DateTime?      @map("purchase_date") @db.Date
  purchaseCostPaise Int?           @map("purchase_cost_paise")
  vendor            String?
  warrantyUntil     DateTime?      @map("warranty_until") @db.Date
  condition         AssetCondition @default(GOOD)
  status            AssetStatus    @default(AVAILABLE)
  locationId        String?        @map("location_id") @db.Uuid
  notes             String?
  /// Values for the type's extra fields
  specs             Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  type        AssetType         @relation(fields: [typeId], references: [id])
  assignments AssetAssignment[]
  repairs     AssetRepair[]
  documents   AssetDocument[]

  @@unique([companyId, tag])
  @@index([companyId, status])
  @@index([companyId, typeId])
  @@index([companyId, warrantyUntil])
  @@map("assets")
}

/// Who held an asset, when, and in what condition
model AssetAssignment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  assetId        String          @map("asset_id") @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  requestId      String?         @map("request_id") @db.Uuid
  assignedById   String?         @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime        @default(now()) @map("assigned_at")
  conditionOut   AssetCondition  @map("condition_out")
  notes          String?
  /// The employee confirmed they received it
  acknowledgedAt DateTime?       @map("acknowledged_at")
  returnedAt     DateTime?       @map("returned_at")
  returnedToId   String?         @map("returned_to_id") @db.Uuid
  conditionIn    AssetCondition? @map("condition_in")
  returnNotes    String?         @map("return_notes")
  /// Loans: when it has to come back
  dueBack        DateTime?       @map("due_back") @db.Date

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId, returnedAt])
  @@index([companyId, employeeId, returnedAt])
  @@map("asset_assignments")
}

/// "I need a monitor" — the IT head and HR both approve, then IT hands one over
model AssetRequest {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  employeeId        String              @map("employee_id") @db.Uuid
  typeId            String              @map("type_id") @db.Uuid
  reason            String
  status            AssetRequestStatus  @default(PENDING)
  itStatus          LeaveApprovalStatus @default(PENDING) @map("it_status")
  itById            String?             @map("it_by_id") @db.Uuid
  itAt              DateTime?           @map("it_at")
  itNote            String?             @map("it_note")
  hrStatus          LeaveApprovalStatus @default(PENDING) @map("hr_status")
  hrById            String?             @map("hr_by_id") @db.Uuid
  hrAt              DateTime?           @map("hr_at")
  hrNote            String?             @map("hr_note")
  /// The asset handed over (when fulfilled)
  assetId           String?             @map("asset_id") @db.Uuid
  /// Who asked (an employee id) — a manager for their team; null = the person themselves
  requestedById     String?             @map("requested_by_id") @db.Uuid
  /// REQUEST | KIT (starter kit / promotion — no approvals)
  source            String              @default("REQUEST")
  /// KEEP | LOAN
  kind              String              @default("KEEP")
  loanFrom          DateTime?           @map("loan_from") @db.Date
  loanUntil         DateTime?           @map("loan_until") @db.Date
  neededBy          DateTime?           @map("needed_by") @db.Date
  /// The step waiting now: LEAD → MANAGER → HR → IT (null when decided)
  stage             String?
  leadApproverId    String?             @map("lead_approver_id") @db.Uuid
  leadStatus        LeaveApprovalStatus @default(SKIPPED) @map("lead_status")
  leadById          String?             @map("lead_by_id") @db.Uuid
  leadAt            DateTime?           @map("lead_at")
  leadNote          String?             @map("lead_note")
  managerApproverId String?             @map("manager_approver_id") @db.Uuid
  managerStatus     LeaveApprovalStatus @default(SKIPPED) @map("manager_status")
  managerById       String?             @map("manager_by_id") @db.Uuid
  managerAt         DateTime?           @map("manager_at")
  managerNote       String?             @map("manager_note")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type     AssetType @relation(fields: [typeId], references: [id])

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@map("asset_requests")
}

/// A repair job (open while the asset is in repair)
model AssetRepair {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  issue       String
  vendor      String?
  costPaise   Int?      @map("cost_paise")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  notes       String?
  createdById String?   @map("created_by_id") @db.Uuid

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([companyId, endedAt])
  @@map("asset_repairs")
}

/// Invoice, warranty card, repair bill… (private files)
model AssetDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  name         String
  fileKey      String   @map("file_key")
  mime         String
  size         Int
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_documents")
}

/// The yearly "do you still have it?" check
model AssetCheck {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  dueOn       DateTime  @map("due_on") @db.Date
  startedAt   DateTime  @default(now()) @map("started_at")
  closedAt    DateTime? @map("closed_at")
  startedById String?   @map("started_by_id") @db.Uuid

  answers AssetCheckAnswer[]

  @@index([companyId, closedAt])
  @@map("asset_checks")
}

model AssetCheckAnswer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkId      String   @map("check_id") @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  /// HAVE | PROBLEM | NOT_WITH_ME
  answer       String
  note         String?
  answeredAt   DateTime @default(now()) @map("answered_at")

  check AssetCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([checkId, assignmentId])
  @@index([checkId, employeeId])
  @@map("asset_check_answers")
}

/// Who gets what when they join (rules add up)
model StarterKitRule {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  name                String
  /// Everyone gets it
  isBase              Boolean  @default(false) @map("is_base")
  /// Role keys (manager, team_lead…) — any match
  roleKeys            String[] @default([]) @map("role_keys")
  /// Designation contains this text (case-insensitive)
  designationContains String?  @map("designation_contains")
  departmentIds       String[] @default([]) @map("department_ids") @db.Uuid
  /// [{ typeId, qty }]
  items               Json
  /// Also when someone moves into this group later (promotion)
  onPromotion         Boolean  @default(true) @map("on_promotion")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(100) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("starter_kit_rules")
}

// ─────────────────────────────────────────────────────────────
// HELPDESK (Plan B5)
// ─────────────────────────────────────────────────────────────

model TicketCategory {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  /// Team key: IT, HR, FINANCE, DEVOPS or a company-made team (HelpdeskTeam.queue)
  queue           String
  name            String
  isActive        Boolean         @default(true) @map("is_active")
  sortOrder       Int             @default(0) @map("sort_order")
  /// Emoji shown next to the name
  icon            String?
  /// One line under the name ("Wi-Fi, VPN, slow internet")
  description     String?
  /// Starting priority of new tickets on this topic (employee can still change it)
  defaultPriority TicketPriority? @map("default_priority")
  /// New tickets go straight to this person (must work the queue); null = team head / team
  routeToId       String?         @map("route_to_id") @db.Uuid
  /// Extra questions: [{ id, label, kind: text|choice|device, options?, required }]
  questions       Json?
  /// Shown while the employee types — many problems never need a ticket
  quickAnswer     String?         @map("quick_answer")
  /// Times an employee said the quick answer helped
  helpedCount     Int             @default(0) @map("helped_count")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tickets Ticket[]

  @@unique([companyId, queue, name])
  @@map("ticket_categories")
}


/// One per queue when the company uses team heads: new tickets go to the head,
/// who assigns them to people in the team (anyone with the queue permission).
/// The backup assigns too, and takes the head's alerts while the head is on leave.
/// No row (or no head) = everyone in the queue can take tickets.
model HelpdeskTeam {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  /// IT, HR, FINANCE, DEVOPS (built in, worked through role permissions) or a generated key for a company-made team
  queue       String
  /// Company-made teams only: name, emoji, one-line "what it helps with" and the people who work it
  custom      Boolean   @default(false)
  label       String?
  emoji       String?
  description String?
  memberIds   String[]  @default([]) @map("member_ids") @db.Uuid
  /// Archived teams take no new tickets; their open tickets can still be finished
  archivedAt  DateTime? @map("archived_at")
  /// User ids (checked against the queue permission when saved)
  headId      String?   @map("head_id") @db.Uuid
  backupId    String?   @map("backup_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, queue])
  @@map("helpdesk_teams")
}

/// An employee's ticket to IT, HR, Finance or DevOps. Never anonymous.
model Ticket {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  /// Per-company running number (#1, #2, …)
  number             Int
  /// Team key (see HelpdeskTeam)
  queue              String
  categoryId         String?        @map("category_id") @db.Uuid
  /// "Report a problem" from My assets
  assetId            String?        @map("asset_id") @db.Uuid
  /// The topic's questions and the employee's answers, as asked: [{ label, answer }]
  answers            Json?
  employeeId         String         @map("employee_id") @db.Uuid
  subject            String
  description        String
  priority           TicketPriority @default(MEDIUM)
  status             TicketStatus   @default(OPEN)
  /// Agent (user) working on it
  assigneeId         String?        @map("assignee_id") @db.Uuid
  firstResponseDueAt DateTime       @map("first_response_due_at")
  resolutionDueAt    DateTime       @map("resolution_due_at")
  firstRespondedAt   DateTime?      @map("first_responded_at")
  resolvedAt         DateTime?      @map("resolved_at")
  closedAt           DateTime?      @map("closed_at")
  reopenCount        Int            @default(0) @map("reopen_count")
  /// 1–5 from the employee after resolution
  rating             Int?
  ratingComment      String?        @map("rating_comment")
  lastActivityAt     DateTime       @default(now()) @map("last_activity_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@unique([companyId, number])
  @@index([companyId, queue, status, resolutionDueAt])
  @@index([companyId, employeeId, createdAt])
  @@index([companyId, assigneeId, status])
  @@index([companyId, status, resolvedAt])
  @@map("tickets")
}

model TicketMessage {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  ticketId  String            @map("ticket_id") @db.Uuid
  /// User who wrote it (null for automatic events)
  authorId  String?           @map("author_id") @db.Uuid
  kind      TicketMessageKind @default(REPLY)
  body      String
  fileKey   String?           @map("file_key")
  fileName  String?           @map("file_name")
  fileMime  String?           @map("file_mime")
  fileSize  Int?              @map("file_size")
  createdAt DateTime          @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ─────────────────────────────────────────────────────────────
// TIMESHEETS
// ─────────────────────────────────────────────────────────────

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// One week (Monday–Sunday, company time zone) of one person's hours.
model Timesheet {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  /// Monday
  weekStart     DateTime        @map("week_start") @db.Date
  status        TimesheetStatus @default(DRAFT)
  totalMinutes  Int             @default(0) @map("total_minutes")
  /// Who may approve this submission (team lead / PM / line manager), snapshotted at submit
  approverIds   String[]        @default([]) @map("approver_ids") @db.Uuid
  approverLabel String?         @map("approver_label")
  submittedAt   DateTime?       @map("submitted_at")
  decidedById   String?         @map("decided_by_id") @db.Uuid
  onBehalfOfId  String?         @map("on_behalf_of_id") @db.Uuid
  decidedAt     DateTime?       @map("decided_at")
  decisionNote  String?         @map("decision_note")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  TimesheetEntry[]

  @@unique([employeeId, weekStart])
  @@index([companyId, status, weekStart])
  @@index([companyId, weekStart])
  @@map("timesheets")
}

/// Minutes on one day for one project (or internal work) and task.
model TimesheetEntry {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  timesheetId   String          @map("timesheet_id") @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  date          DateTime        @db.Date
  /// null = internal / non-project work
  projectId     String?         @map("project_id") @db.Uuid
  task          String
  billable      Boolean         @default(false)
  minutes       Int
  /// Row order in the week grid
  line          Int             @default(0)
  /// Time block: minutes from midnight of `date` (end may pass 1440 for night work). Null on old grid rows.
  startMin      Int?            @map("start_min")
  endMin        Int?            @map("end_min")
  /// What the person did
  description   String?
  /// Development, Meeting, Review…
  workType      String?         @map("work_type")
  /// Each block is approved on its own (by the person's lead on that project)
  status        TimesheetStatus @default(DRAFT)
  approverIds   String[]        @default([]) @map("approver_ids") @db.Uuid
  approverLabel String?         @map("approver_label")
  submittedAt   DateTime?       @map("submitted_at")
  /// Employee's note to the approver when submitting
  submitNote    String?         @map("submit_note")
  decidedById   String?         @map("decided_by_id") @db.Uuid
  onBehalfOfId  String?         @map("on_behalf_of_id") @db.Uuid
  decidedAt     DateTime?       @map("decided_at")
  /// Approver's note (why it was sent back)
  decisionNote  String?         @map("decision_note")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("TimesheetEntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([timesheetId])
  @@index([companyId, projectId, date])
  @@index([companyId, employeeId, date])
  @@map("timesheet_entries")
}

/// Super Admin's own labels on a company ("Pilot", "Billing hold") — never shown to the company
model CompanyTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, label])
  @@index([label])
  @@map("company_tags")
}

/// Super Admin's internal notes about a company — never shown to the company
model CompanyNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("company_notes")
}

/// One row per person per day they used the portal (sign-in or session refresh) — powers active-user trends
model UserActivityDay {
  userId    String   @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  day       DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([companyId, day])
  @@map("user_activity_days")
}

// ─────────────────────────────────────────────────────────────
// SYSTEM — health history, events, email log, sign-in attempts
// (Super Admin → System). Cleared automatically after a while.
// ─────────────────────────────────────────────────────────────

/// One health check every few minutes (kept 90 days)
model SystemHealthSample {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at       DateTime @default(now())
  ok       Boolean
  /// { database: 'ok' | 'error' | 'disabled', redis, elasticsearch, email }
  services Json
  /// { database: 4, email: 612 } in ms
  latency  Json?

  @@index([at])
  @@map("system_health_samples")
}

/// Things worth showing on the timeline: API started, updated, maintenance on/off
model SystemEvent {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at     DateTime @default(now())
  /// started | updated | maintenance_on | maintenance_off | caches_cleared
  kind   String
  title  String
  detail String?

  @@index([at])
  @@map("system_events")
}

/// Every email the platform tried to send — subject, recipient and result only.
/// A failed email keeps its content encrypted for 7 days so it can be retried.
model EmailLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String?   @map("company_id") @db.Uuid
  to         String
  subject    String
  /// SENT | FAILED
  status     String
  error      String?
  provider   String
  durationMs Int?      @map("duration_ms")
  /// Encrypted HTML, failed emails only (removed once retried or after 7 days)
  payload    String?
  retriedAt  DateTime? @map("retried_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}

/// Sign-in attempts for the safety numbers (kept 30 days)
model SignInAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at        DateTime @default(now())
  success   Boolean
  userId    String?  @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  @@index([at])
  @@index([userId, at])
  @@map("sign_in_attempts")
}

/// Reports & analytics emailed on a schedule. Each recipient gets numbers for
/// what they may see (their own report scope), worked out when it's sent.
model ReportSchedule {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  /// Who set it up
  ownerId      String    @map("owner_id") @db.Uuid
  /// overview | people | attendance | utilisation
  report       String
  /// DAILY | WEEKLY | MONTHLY
  frequency    String
  /// 1 = Monday … 7 = Sunday (weekly)
  dayOfWeek    Int?      @map("day_of_week")
  /// 1–28 (monthly)
  dayOfMonth   Int?      @map("day_of_month")
  /// Local hour in the company time zone
  hour         Int
  recipientIds String[]  @map("recipient_ids") @db.Uuid
  attachCsv    Boolean   @default(false) @map("attach_csv")
  /// { departmentId?, locationId? }
  filters      Json?
  active       Boolean   @default(true)
  nextRunAt    DateTime  @map("next_run_at")
  lastSentAt   DateTime? @map("last_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
  @@index([companyId])
  @@map("report_schedules")
}

/// Festival looks (Diwali, New Year…) that switch on and back by themselves
model SeasonalTheme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// Ready-made key (diwali, new_year…) or null for your own
  preset      String?
  name        String
  emoji       String
  /// First and last day (company time zone), as YYYY-MM-DD
  startsOn    String   @map("starts_on")
  endsOn      String   @map("ends_on")
  /// Repeat next year (moving festivals follow the preset dates)
  everyYear   Boolean  @default(true) @map("every_year")
  /// { main, accent, deep } hex colours
  colors      Json
  /// diyas | sparkles | fireworks | snow | ribbon | kites | petals | splash | lanterns | marigold | dandiya | confetti | none
  decoration  String   @default("none")
  greeting    String?
  onSignIn    Boolean  @default(true) @map("on_sign_in")
  enabled     Boolean  @default(true)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startsOn])
  @@map("seasonal_themes")
}

// ============================================================
// Resource requests & releases
//   REQUEST: a Lead asks for a person → PM → Delivery Director → PMO
//   RELEASE: a Lead no longer needs someone → PM / Delivery Director decide
// Every step is kept in ResourceRequestEvent; every change to someone's
// assignments is kept in AssignmentLog (their assignment history).
// ============================================================

enum ResourceRequestKind {
  REQUEST
  RELEASE
}

enum ResourceRequestStatus {
  OPEN
  ON_HOLD
  /// Filling takes time off another PM's project — waiting for that PM to agree
  AWAITING_CONSENT
  FILLED
  REJECTED
  WITHDRAWN
  /// Releases: sent to the PMO pool / moved to another project / kept
  RELEASED
  REASSIGNED
  KEPT
}

enum ResourceStep {
  PM
  DD
  PMO
}

model ResourceRequest {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  projectId          String                @map("project_id") @db.Uuid
  kind               ResourceRequestKind
  status             ResourceRequestStatus @default(OPEN)
  /// Who acts now (releases: PM and Delivery Director both may)
  step               ResourceStep          @default(PM)
  /// Null for requests moved over from old "open roles"
  raisedByUserId     String?               @map("raised_by_user_id") @db.Uuid
  raisedByEmployeeId String?               @map("raised_by_employee_id") @db.Uuid
  reason             String

  // Request
  title               String?
  skills              String[]  @default([])
  allocation          Int?
  fromDate            DateTime? @map("from_date") @db.Date
  untilDate           DateTime? @map("until_date") @db.Date
  preferredEmployeeId String?   @map("preferred_employee_id") @db.Uuid

  // Release
  memberId          String?   @map("member_id") @db.Uuid
  releaseEmployeeId String?   @map("release_employee_id") @db.Uuid
  lastDate          DateTime? @map("last_date") @db.Date
  handover          String?

  // On hold
  holdReason   String?   @map("hold_reason")
  heldAt       DateTime? @map("held_at")
  heldByUserId String?   @map("held_by_user_id") @db.Uuid
  remindAt     DateTime? @map("remind_at") @db.Date
  remindedAt   DateTime? @map("reminded_at")
  holdNudgedAt DateTime? @map("hold_nudged_at")

  /// A fill waiting for another PM's agreement: { employeeId, allocation, note, takeFrom: { memberId, allocation }, byUserId, consentUserId }
  pendingFill Json? @map("pending_fill")

  // Outcome
  filledEmployeeId  String?   @map("filled_employee_id") @db.Uuid
  filledAllocation  Int?      @map("filled_allocation")
  targetProjectId   String?   @map("target_project_id") @db.Uuid
  outcomeNote       String?   @map("outcome_note")
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at")
  /// PMO nudged the PM / Delivery Director about a waiting release
  nudgedAt          DateTime? @map("nudged_at")
  /// "Raise again" / "Request back" — the earlier request
  previousRequestId String?   @map("previous_request_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  ResourceRequestEvent[]

  @@index([companyId, status])
  @@index([projectId, status])
  @@index([raisedByUserId])
  @@map("resource_requests")
}

/// One step of a request: raised, forwarded, held, unheld, filled, rejected, withdrawn, consent…
model ResourceRequestEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  kind        String
  note        String?
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  request ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("resource_request_events")
}

/// Someone's assignment history: assigned, changed, released, to the PMO pool, reassigned…
model AssignmentLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  requestId   String?  @map("request_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// assigned | changed | removed | released | to_pool | reassigned | requested
  action      String
  allocation  Int?
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId, employeeId, createdAt])
  @@map("assignment_logs")
}
