// ============================================================
// HRMS Portal — Prisma Schema
// Database: PostgreSQL 16
// Multi-tenancy: Shared schema with company_id on every table
// ============================================================

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL — pooled connection used by the running API
//                (Supabase transaction pooler, port 6543, ?pgbouncer=true)
// DIRECT_URL   — session/direct connection used by `prisma migrate`
//                (Supabase session pooler, port 5432)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum FeatureOverride {
  ON
  OFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum LeaveAdjustmentKind {
  /// Days added for good (gift)
  EXTRA
  /// Allows going below 0 (lendLimit); what is used below 0 is taken from next year
  LEND
  /// Fixing a mistake (+ or −)
  CORRECTION
  /// Days removed (encashment, leave taken outside the system)
  DEDUCTION
  /// Written at the start of a year: days owed from last year taken back
  TAKEN_BACK
  /// HR cancelled what is owed
  WAIVED
}

enum ExtraLeaveStatus {
  PENDING
  LENT
  GIVEN
  DECLINED
  CANCELLED
}

enum LeaveAvailability {
  EVERYONE
  RULES
  GRANT_ONLY
}

enum LeaveMemberMode {
  INCLUDE
  EXCLUDE
}

enum LeaveGrantStatus {
  ACTIVE
  REVOKED
}

enum LeaveGrantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTypeCategory {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
  WORK_FROM_HOME
  OTHER
}

/// How a leave type's balance builds up over the year
enum LeaveAccrual {
  /// Whole year credited on Jan 1 (prorated from the joining date)
  UPFRONT
  /// quota / 12 credited each month
  MONTHLY
  /// No balance — unlimited (e.g. Work from home, Unpaid)
  NONE
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
  WORK_FROM_HOME
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetRequestStatus {
  /// Waiting for the IT head and HR (in parallel)
  PENDING
  /// Both approved — IT hands over an asset
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

enum ExpenseClaimStatus {
  DRAFT
  /// Waiting for the manager step, then Finance + HR (in parallel)
  PENDING
  /// Finance and HR both approved — waiting to be paid
  APPROVED
  PAID
  /// Sent back — the employee can edit and resubmit
  REJECTED
  CANCELLED
}

enum ExpenseStage {
  MANAGER
  FINANCE
  HR
}

enum AnnouncementAudience {
  COMPANY
  DEPARTMENTS
  LOCATIONS
  /// Everyone below teamManagerId in the reporting line
  TEAM
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

/// Client work is billable; company work is an investment
enum ProjectType {
  CLIENT
  INTERNAL
}

enum ProjectRole {
  MEMBER
  TEAM_LEAD
  MANAGER
}

enum RegularisationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  LOCKED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayslipStatus {
  GENERATED
  PUBLISHED
  VIEWED
}

enum TaxRegime {
  OLD
  NEW
}

enum ImportJobStatus {
  UPLOADED
  PARSING
  PARSED
  VALIDATING
  AWAITING_CONFIRMATION
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportEntityType {
  EMPLOYEE
  ATTENDANCE
  LEAVE_BALANCE
  SALARY_STRUCTURE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  /// Waiting for the employee to reply
  WAITING
  RESOLVED
  CLOSED
}

/// Helpdesk queues (fixed: only these three teams take tickets)
enum TicketMessageKind {
  /// Visible to the employee
  REPLY
  /// Internal note, agents only
  NOTE
  /// System line: status change, assignment, queue move
  EVENT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────
// CORE IDENTITY
// ─────────────────────────────────────────────────────────────

/// Core user identity — one row per human, regardless of company
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique
  passwordHash       String     @map("password_hash")
  /// Set when an admin issues a temporary password; the user must choose their own before using the portal
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(ACTIVE)
  isSuperAdmin       Boolean    @default(false) @map("is_super_admin")
  /// null for Super Admin; set for all company-scoped users
  companyId          String?    @map("company_id") @db.Uuid
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  /// When the password was last set (age shown on Profile & security)
  passwordChangedAt  DateTime?  @map("password_changed_at")
  loginAttempts      Int        @default(0) @map("login_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  company             Company?                   @relation(fields: [companyId], references: [id])
  preferences         UserPreferences?
  refreshTokens       RefreshToken[]
  delegationsGiven    ApprovalDelegation[]       @relation("Delegator")
  delegationsReceived ApprovalDelegation[]       @relation("Delegate")
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  userRoles           UserRole[]
  employee            Employee?
  auditLogs           AuditLog[]                 @relation("AuditLogUser")
  uploadedDocuments   EmployeeDocument[]         @relation("DocumentUploader")
  reviewedCorrections AttendanceRegularisation[] @relation("CorrectionReviewer")
  coveredCorrections  AttendanceRegularisation[] @relation("CorrectionOnBehalfOf")
  leaveApprovals      LeaveApproval[]            @relation("LeaveApprover")
  leaveActions        LeaveApproval[]            @relation("LeaveActedBy")
  leaveCovered        LeaveApproval[]            @relation("LeaveOnBehalfOf")
  leaveAdjustments    LeaveBalanceAdjustment[]   @relation("LeaveAdjustedBy")
  notifications       Notification[]
  announcements       Announcement[]             @relation("AnnouncementAuthor")
  announcementReads   AnnouncementRead[]
  kudosGiven          Kudos[]                    @relation("KudosFrom")
  celebrationWishes   CelebrationWish[]          @relation("CelebrationWishFrom")
  kudosReactions      KudosReaction[]
  companyNotes        CompanyNote[]
  activityDays        UserActivityDay[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

/// Per-user UI and notification preferences
model UserPreferences {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String  @unique @map("user_id") @db.Uuid
  theme                String  @default("system")
  timezone             String  @default("Asia/Kolkata")
  dateFormat           String  @default("DD/MM/YYYY") @map("date_format")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  emailNotifications   Boolean @default(true) @map("email_notifications")
  /// theme | compact | normal | spacious — "theme" follows the company/platform theme
  density              String  @default("theme")
  /// theme | sm | md | lg | xl — "theme" follows the theme's text scale
  textSize             String  @default("theme") @map("text_size")
  /// Always reduce animations (the OS setting is honoured regardless)
  reduceMotion         Boolean @default(false) @map("reduce_motion")
  /// Built-in theme key; null = the company theme
  colorTheme           String? @map("color_theme")
  /// classic | glide | peek | floating | collapsible; null = the company default
  menuStyle            String? @map("menu_style")
  /// Page background pack (signature …); null = the company default
  backdropPack         String? @map("backdrop_pack")
  /// lively | calm | off; null = the company default
  backdropLevel        String? @map("backdrop_level")
  /// Small view settings that follow the person (chart styles, open menu sections, calendar views…)
  uiState              Json    @default("{}") @map("ui_state")
  /// Super Admins: email me when a new device signs in
  notifyNewDevice      Boolean @default(true) @map("notify_new_device")
  /// Sign out after this many idle minutes (null = never)
  idleTimeoutMinutes   Int?    @map("idle_timeout_minutes")
  /// Super Admins: ask for the password again before risky changes
  reauthForRisky       Boolean @default(false) @map("reauth_for_risky")
  /// Per topic: { time: { app: true, email: false }, … } — missing = on
  notificationTopics   Json    @default("{}") @map("notification_topics")
  /// Quiet hours for emails: { on, from: "20:00", to: "08:00", weekends }
  quietHours           Json?   @map("quiet_hours")
  /// One summary email a day instead of one per notification
  dailySummary         Boolean @default(false) @map("daily_summary")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// JWT refresh tokens with family-based reuse detection
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Tokens in the same family are related — reuse invalidates the whole family
  familyId  String   @map("family_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  // Device info shown in "Active sessions" (captured at login / refresh)
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Short-lived tokens for password reset flow
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Short-lived tokens for email verification flow
model EmailVerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  /// Set for an email change: the address being confirmed (the link goes there)
  newEmail   String?   @map("new_email")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────────────────────
// MULTI-TENANT — COMPANIES
// ─────────────────────────────────────────────────────────────

/// A tenant / company in the HRMS platform
model Company {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  /// URL-safe unique identifier — used in SSO and deep-link URLs
  slug             String        @unique
  email            String        @unique
  status           CompanyStatus @default(ACTIVE)
  /// Subscription plan → which features the company can use (plus company_features overrides)
  planId           String?       @map("plan_id") @db.Uuid
  /// Bumped on any plan/feature change → access caches refresh on the next request
  featuresVersion  Int           @default(1) @map("features_version")
  /// Bumped on any reporting-line / department-tree change
  hierarchyVersion Int           @default(1) @map("hierarchy_version")
  /// Per-company limit overrides on top of the plan, e.g. { "maxEmployees": 800 } (null value = unlimited)
  limits           Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  plan                Plan?                 @relation(fields: [planId], references: [id])
  features            CompanyFeature[]
  orgLevels           OrgLevel[]
  employeeHierarchy   EmployeeHierarchy[]
  departmentHierarchy DepartmentHierarchy[]
  delegations         ApprovalDelegation[]

  users           User[]
  settings        CompanySettings?
  branding        CompanyBranding?
  roles           Role[]
  employees       Employee[]
  departments     Department[]
  designations    Designation[]
  officeLocations OfficeLocation[]
  leaveTypes      LeaveType[]
  projects        Project[]
  holidays        PublicHoliday[]
  seasonalThemes  SeasonalTheme[]
  payrollRuns     PayrollRun[]
  payslips        Payslip[]
  importJobs      ImportJob[]
  auditLogs       AuditLog[]
  tags            CompanyTag[]
  notes           CompanyNote[]
  reportSchedules ReportSchedule[]

  @@map("companies")
}

/// Operational configuration per company
model CompanySettings {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  /// Prefix for generated employee IDs — e.g. "CL" → "CL001"
  employeeIdPrefix     String   @default("EMP") @map("employee_id_prefix")
  /// Auto-incrementing sequence for next employee ID
  employeeIdSequence   Int      @default(0) @map("employee_id_sequence")
  timezone             String   @default("Asia/Kolkata")
  /// 1=Jan … 4=Apr (India default: April)
  fiscalYearStart      Int      @default(4) @map("fiscal_year_start")
  workingDaysPerWeek   Int      @default(5) @map("working_days_per_week")
  workingHoursPerDay   Int      @default(8) @map("working_hours_per_day")
  /// Employees may pick their own colour theme
  personalThemes       Boolean  @default(true) @map("personal_themes")
  /// Built-in theme keys employees may pick; empty = all
  allowedThemes        String[] @default([]) @map("allowed_themes")
  /// Employees may pick their own menu style
  personalMenuStyle    Boolean  @default(true) @map("personal_menu_style")
  /// classic | glide | peek | floating | collapsible
  defaultMenuStyle     String   @default("classic") @map("default_menu_style")
  /// Page background pack for everyone who hasn't picked one
  defaultBackdropPack  String   @default("signature") @map("default_backdrop_pack")
  /// lively | calm | off
  defaultBackdropLevel String   @default("lively") @map("default_backdrop_level")
  /// Company defaults for view settings (same keys as UserPreferences.uiState)
  uiDefaults           Json     @default("{}") @map("ui_defaults")
  /// When an internship ends: remind (HR decides) | convert (to Full-time automatically)
  internshipEndAction  String   @default("remind") @map("internship_end_action")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

/// Visual branding per company — logo, favicon, colors
model CompanyBranding {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String  @unique @map("company_id") @db.Uuid
  logoUrl          String? @map("logo_url")
  faviconUrl       String? @map("favicon_url")
  primaryColor     String  @default("#1E40AF") @map("primary_color")
  secondaryColor   String  @default("#EFF6FF") @map("secondary_color")
  /// Name displayed in the portal header (may differ from legal company name)
  displayName      String  @map("display_name")
  /// Company theme (ThemeTokens snapshot). Null → platform default theme.
  themeTokens      Json?   @map("theme_tokens")
  /// Library theme it was created from (ThemeRef), for display only
  themeSource      Json?   @map("theme_source")
  /// Short line under the name in the side menu
  tagline          String?
  /// Logo used in dark mode (usually a white version)
  logoDarkUrl      String? @map("logo_dark_url")
  /// Sign-in page: welcome line, background (pack | photo | plain) and photo
  signInMessage    String? @map("sign_in_message")
  signInBackground String  @default("pack") @map("sign_in_background")
  signInPhotoUrl   String? @map("sign_in_photo_url")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_branding")
}

// ─────────────────────────────────────────────────────────────
// RBAC — ROLES & PERMISSIONS
// ─────────────────────────────────────────────────────────────

/// All resource:action permission keys — seeded from @hrms/types PERMISSIONS
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String
  action      String
  /// Canonical key e.g. "employee:create" — must match PERMISSIONS constant
  key         String   @unique
  description String   @default("")
  /// Catalog feature this permission belongs to (e.g. "time.leave")
  featureKey  String?  @map("feature_key")
  label       String   @default("")
  /// Scopes the permission supports (empty = unscoped)
  scopes      String[] @default([])
  sensitive   Boolean  @default(false)
  /// No longer in the catalog (kept so old grants don't break)
  deprecated  Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

/// Roles: system roles (companyId=null) and company-custom roles
model Role {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String?    @map("company_id") @db.Uuid
  name         String
  description  String     @default("")
  /// System roles cannot be deleted or renamed
  isSystemRole Boolean    @default(false) @map("is_system_role")
  /// Stable key for template-derived roles ("company_admin", "hr", …); null for custom roles
  key          String?
  /// Owner role (Company Admin): every permission of every enabled feature, not editable
  isOwner      Boolean    @default(false) @map("is_owner")
  /// Global template (company_id null) cloned into each company
  isTemplate   Boolean    @default(false) @map("is_template")
  status       RoleStatus @default(ACTIVE)
  /// Bumped on every grant change → cached access refreshes on the next request
  version      Int        @default(1)
  createdById  String?    @map("created_by") @db.Uuid
  updatedById  String?    @map("updated_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  company         Company?         @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

/// Many-to-many: Role ↔ Permission
model RolePermission {
  roleId       String  @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  /// AccessScope (own … company); null for unscoped permissions
  scope        String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Many-to-many: User ↔ Role (scoped to a company)
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId, companyId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────
// ORGANIZATION STRUCTURE
// ─────────────────────────────────────────────────────────────

/// Work locations / offices
model OfficeLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  address   String?
  city      String?
  state     String?
  country   String   @default("India")
  pincode   String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@index([companyId])
  @@map("office_locations")
}

/// Department tree — supports unlimited depth
model Department {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  name               String
  code               String
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  headEmployeeId     String?  @map("head_employee_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company          Company               @relation(fields: [companyId], references: [id])
  parentDepartment Department?           @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[]          @relation("DepartmentHierarchy")
  employees        Employee[]
  ancestors        DepartmentHierarchy[] @relation("DeptDescendant")
  descendants      DepartmentHierarchy[] @relation("DeptAncestor")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("departments")
}

/// Job titles / designations
model Designation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String
  /// 1=entry-level, higher=senior. Used for hierarchy-aware approvals
  level      Int      @default(1)
  orgLevelId String?  @map("org_level_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  orgLevel  OrgLevel?  @relation(fields: [orgLevelId], references: [id], onDelete: SetNull)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("designations")
}

// ─────────────────────────────────────────────────────────────
// EMPLOYEES
// ─────────────────────────────────────────────────────────────

/// Employee profile — linked 1:1 to a User account
model Employee {
  id                           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                    String           @map("company_id") @db.Uuid
  /// Human-readable ID e.g. "CL001" — unique within company
  employeeId                   String           @map("employee_id")
  userId                       String           @unique @map("user_id") @db.Uuid
  firstName                    String           @map("first_name")
  lastName                     String           @map("last_name")
  email                        String
  phone                        String?
  gender                       Gender?
  dateOfBirth                  DateTime?        @map("date_of_birth") @db.Date
  avatarUrl                    String?          @map("avatar_url")
  employmentType               EmploymentType   @default(FULL_TIME) @map("employment_type")
  employmentStatus             EmploymentStatus @default(ACTIVE) @map("employment_status")
  departmentId                 String?          @map("department_id") @db.Uuid
  designationId                String?          @map("designation_id") @db.Uuid
  locationId                   String?          @map("location_id") @db.Uuid
  reportingManagerId           String?          @map("reporting_manager_id") @db.Uuid
  /// Reports to the PMO (the central pool) instead of a person — leave / timesheets go to the PMO lead
  reportsToPmo                 Boolean          @default(false) @map("reports_to_pmo")
  /// Skills the person lists on their profile (matched against resource requests)
  skills                       String[]         @default([])
  /// Work experience before joining, in months (total experience = this + time here; null = not given)
  priorExperienceMonths        Int?             @map("prior_experience_months")
  /// The person entered experience before joining that HR hasn't verified yet (months); the approved value stays in priorExperienceMonths
  priorExperiencePendingMonths Int?             @map("prior_experience_pending_months")
  priorExperienceSubmittedAt   DateTime?        @map("prior_experience_submitted_at")
  /// Who verified the approved value and when (HR entering it themselves counts as verified)
  priorExperienceVerifiedAt    DateTime?        @map("prior_experience_verified_at")
  priorExperienceVerifiedById  String?          @map("prior_experience_verified_by_id") @db.Uuid
  /// null = the company's general shift
  shiftId                      String?          @map("shift_id") @db.Uuid
  joiningDate                  DateTime         @map("joining_date") @db.Date
  confirmationDate             DateTime?        @map("confirmation_date") @db.Date
  /// Interns: when the internship ends (HR converts, extends or ends it then)
  internshipEndDate            DateTime?        @map("internship_end_date") @db.Date
  /// Interns: never convert automatically, even when the company turns that on
  skipAutoConvert              Boolean          @default(false) @map("skip_auto_convert")
  terminationDate              DateTime?        @map("termination_date") @db.Date
  /// Opt-in: show day + month of birth to colleagues (Spotlight)
  showBirthday                 Boolean          @default(false) @map("show_birthday")
  /// Why they are leaving / left: resigned | let_go | contract_end | retired | other
  exitReason                   String?          @map("exit_reason")
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @updatedAt @map("updated_at")

  company            Company                    @relation(fields: [companyId], references: [id])
  user               User                       @relation(fields: [userId], references: [id])
  department         Department?                @relation(fields: [departmentId], references: [id])
  designation        Designation?               @relation(fields: [designationId], references: [id])
  location           OfficeLocation?            @relation(fields: [locationId], references: [id])
  shift              WorkShift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  holidayChoices     HolidayChoice[]
  reportingManager   Employee?                  @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates       Employee[]                 @relation("ManagerSubordinates")
  bankDetails        EmployeeBankDetails?
  statutoryInfo      EmployeeStatutory?
  personal           EmployeePersonal?
  documents          EmployeeDocument[]
  salaryComponents   EmployeeSalary[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  leaveTypeMembers   LeaveTypeMember[]
  leaveGrants        LeaveGrant[]
  leaveGrantRequests LeaveGrantRequest[]
  extraLeaveRequests ExtraLeaveRequest[]
  attendanceRecords  AttendanceRecord[]
  timesheetEntries   TimesheetEntry[]           @relation("TimesheetEntryEmployee")
  regularisations    AttendanceRegularisation[]
  kudosReceived      KudosRecipient[]
  wishesReceived     CelebrationWish[]          @relation("CelebrationWishTo")
  expenseClaims      ExpenseClaim[]
  assetAssignments   AssetAssignment[]
  assetRequests      AssetRequest[]
  tickets            Ticket[]
  timesheets         Timesheet[]
  projectMembers     ProjectMember[]            @relation("ProjectMemberEmployee")
  ledMembers         ProjectMember[]            @relation("ProjectMemberLead")
  ownedMilestones    ProjectMilestone[]         @relation("MilestoneOwner")
  directedProjects   Project[]                  @relation("ProjectDeliveryDirector")
  payslips           Payslip[]
  events             EmployeeEvent[]
  checklistItems     EmployeeChecklistItem[]
  /// Closure table: everyone above me (incl. myself at depth 0)
  ancestors          EmployeeHierarchy[]        @relation("HierarchyDescendant")
  /// Closure table: everyone below me (incl. myself at depth 0)
  descendants        EmployeeHierarchy[]        @relation("HierarchyAncestor")

  @@unique([companyId, employeeId])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, employmentStatus])
  @@index([reportingManagerId])
  @@map("employees")
}

/// Bank account details for salary disbursement
/// Private personal details — only the employee and roles with employee.view_private see these
model EmployeePersonal {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  employeeId               String   @unique @map("employee_id") @db.Uuid
  personalEmail            String?  @map("personal_email")
  bloodGroup               String?  @map("blood_group")
  maritalStatus            String?  @map("marital_status")
  /// { line1, line2, city, state, postalCode, country }
  currentAddress           Json?    @map("current_address")
  permanentAddress         Json?    @map("permanent_address")
  emergencyContactName     String?  @map("emergency_contact_name")
  emergencyContactRelation String?  @map("emergency_contact_relation")
  emergencyContactPhone    String?  @map("emergency_contact_phone")
  updatedAt                DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("employee_personal")
}

/// Uploaded files (offer letters, ID proofs…) kept on private storage, downloaded through the API only
model EmployeeDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  category     String
  name         String
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @unique @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@map("employee_documents")
}

model EmployeeBankDetails {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  employeeId        String   @unique @map("employee_id") @db.Uuid
  accountHolderName String   @map("account_holder_name")
  /// Application-level encrypted (AES-256-GCM, PII_ENCRYPTION_KEY)
  accountNumber     String   @map("account_number")
  accountLast4      String   @map("account_last4")
  ifscCode          String   @map("ifsc_code")
  bankName          String   @map("bank_name")
  branchName        String   @map("branch_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("employee_bank_details")
}

/// India statutory info — PAN, Aadhaar, UAN, ESIC
model EmployeeStatutory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String    @unique @map("employee_id") @db.Uuid
  /// Application-level encrypted
  pan          String?
  /// Only the last 4 digits are kept — the full Aadhaar number is never stored
  aadhaarLast4 String?   @map("aadhaar_last4")
  uan          String?
  esicNumber   String?   @map("esic_number")
  pfAccountNo  String?   @map("pf_account_no")
  taxRegime    TaxRegime @default(NEW) @map("tax_regime")
  isPfEnabled  Boolean   @default(true) @map("is_pf_enabled")
  isEsiEnabled Boolean   @default(false) @map("is_esi_enabled")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("employee_statutory")
}

/// Employment history — one row per change to someone's job (who made it, when)
model EmployeeEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  /// joined | manager | department | title | location | type | status | confirmed | probation_extended | converted | internship_extended | notice | notice_withdrawn | left
  kind        String
  fromLabel   String?   @map("from_label")
  toLabel     String?   @map("to_label")
  /// When the change takes effect (last day, new probation end…)
  effectiveOn DateTime? @map("effective_on") @db.Date
  note        String?
  /// Null = done by the system (e.g. import)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, createdAt])
  @@map("employee_events")
}

/// Joining / exit checklist items for one person
model EmployeeChecklistItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  /// joining | exit
  kind         String
  label        String
  sortOrder    Int       @default(0) @map("sort_order")
  doneAt       DateTime? @map("done_at")
  doneByUserId String?   @map("done_by_user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, kind])
  @@map("employee_checklist_items")
}

// ─────────────────────────────────────────────────────────────
// PAYROLL — SALARY STRUCTURE
// ─────────────────────────────────────────────────────────────

/// Active salary structure for an employee (point-in-time)
model EmployeeSalary {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  ctc              Float     @map("ctc") // Annual CTC
  basicSalary      Float     @map("basic_salary") // Monthly
  hra              Float     @default(0) @map("hra")
  specialAllowance Float     @default(0) @map("special_allowance")
  otherAllowances  Float     @default(0) @map("other_allowances")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId])
  @@index([companyId, effectiveFrom])
  @@map("employee_salaries")
}

/// Monthly payroll run — one per month per company
model PayrollRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  month           Int // 1-12
  year            Int
  status          PayrollRunStatus @default(DRAFT)
  totalEmployees  Int              @default(0) @map("total_employees")
  totalGross      Float            @default(0) @map("total_gross")
  totalDeductions Float            @default(0) @map("total_deductions")
  totalNet        Float            @default(0) @map("total_net")
  processedAt     DateTime?        @map("processed_at")
  processedBy     String?          @map("processed_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  payslips Payslip[]

  @@unique([companyId, month, year])
  @@index([companyId, status])
  @@map("payroll_runs")
}

/// Individual payslip per employee per month
model Payslip {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  payrollRunId     String        @map("payroll_run_id") @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  month            Int
  year             Int
  status           PayslipStatus @default(GENERATED)
  // Earnings
  basicSalary      Float         @map("basic_salary")
  hra              Float         @default(0)
  specialAllowance Float         @default(0) @map("special_allowance")
  otherAllowances  Float         @default(0) @map("other_allowances")
  overtimeAmount   Float         @default(0) @map("overtime_amount")
  bonus            Float         @default(0)
  grossEarnings    Float         @map("gross_earnings")
  // Deductions
  employeePf       Float         @default(0) @map("employee_pf")
  employeeEsi      Float         @default(0) @map("employee_esi")
  professionalTax  Float         @default(0) @map("professional_tax")
  tds              Float         @default(0)
  loanEmi          Float         @default(0) @map("loan_emi")
  otherDeductions  Float         @default(0) @map("other_deductions")
  totalDeductions  Float         @map("total_deductions")
  netSalary        Float         @map("net_salary")
  // Employer contributions
  employerPf       Float         @default(0) @map("employer_pf")
  employerEsi      Float         @default(0) @map("employer_esi")
  ctc              Float         @default(0)
  // Statutory
  taxRegime        TaxRegime     @default(NEW) @map("tax_regime")
  pdfUrl           String?       @map("pdf_url")
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  company    Company    @relation(fields: [companyId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([companyId, employeeId])
  @@index([companyId, month, year])
  @@map("payslips")
}

// ─────────────────────────────────────────────────────────────
// LEAVE MANAGEMENT
// ─────────────────────────────────────────────────────────────

/// Leave policy types — CL, SL, EL etc.
model LeaveType {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  name                  String
  code                  String // e.g. "CL", "SL"
  category              LeaveTypeCategory
  description           String?
  color                 String            @default("#6366F1")
  accrual               LeaveAccrual      @default(UPFRONT)
  /// Days per calendar year (ignored when accrual = NONE)
  annualQuota           Float             @default(0) @map("annual_quota")
  carryForward          Boolean           @default(false) @map("carry_forward")
  maxCarryForward       Float             @default(0) @map("max_carry_forward")
  isPaid                Boolean           @default(true) @map("is_paid")
  allowHalfDay          Boolean           @default(true) @map("allow_half_day")
  /// Reporting-chain levels that must approve (0 = approved automatically)
  approvalLevels        Int               @default(1) @map("approval_levels")
  minNoticeDays         Int               @default(0) @map("min_notice_days")
  maxConsecutiveDays    Int?              @map("max_consecutive_days")
  /// Count weekly offs and holidays inside the range (e.g. maternity)
  includeNonWorkingDays Boolean           @default(false) @map("include_non_working_days")
  /// Attendance shows these days as worked (Work from home)
  countsAsPresent       Boolean           @default(false) @map("counts_as_present")
  /// Who can use it: everyone, people matching the rules below, or only people HR grants it to
  availability          LeaveAvailability @default(EVERYONE)
  /// Rules (RULES: who has it; GRANT_ONLY: who may ask for a grant). Empty = any. Rules combine with AND, values with OR.
  genders               Gender[]          @default([])
  departmentIds         String[]          @default([]) @map("department_ids") @db.Uuid
  locationIds           String[]          @default([]) @map("location_ids") @db.Uuid
  designationIds        String[]          @default([]) @map("designation_ids") @db.Uuid
  employmentTypes       EmploymentType[]  @default([]) @map("employment_types")
  /// Months since joining before the type is available
  minServiceMonths      Int?              @map("min_service_months")
  /// People who report to these managers
  managerIds            String[]          @default([]) @map("manager_ids") @db.Uuid
  /// ...at any level below them (not just direct reports)
  managerDeep           Boolean           @default(false) @map("manager_deep")
  /// Current members of these projects
  projectIds            String[]          @default([]) @map("project_ids") @db.Uuid
  /// GRANT_ONLY: a grant (and a request for one) must carry a supporting document
  grantNeedsDocument    Boolean           @default(false) @map("grant_needs_document")
  /// Not usable while the person is on probation
  blockDuringProbation  Boolean           @default(false) @map("block_during_probation")
  /// Ask for a supporting document when a request is longer than this many days (null = never)
  documentAfterDays     Int?              @map("document_after_days")
  /// Weekly offs / holidays between leave days count as leave ("sandwich rule")
  sandwichRule          Boolean           @default(false) @map("sandwich_rule")
  /// Days that may be taken in advance (balance can go this far below 0)
  negativeBalance       Float             @default(0) @map("negative_balance")
  /// Below 0 at year end: take it from next year (true) or forgive it. Lent days are always taken back.
  recoverNegative       Boolean           @default(true) @map("recover_negative")
  /// "MM-DD": carried-forward days not used by then lapse (null = never)
  carryExpiry           String?           @map("carry_expiry")
  isActive              Boolean           @default(true) @map("is_active")
  sortOrder             Int               @default(0) @map("sort_order")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id])
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  members       LeaveTypeMember[]
  grants        LeaveGrant[]
  grantRequests LeaveGrantRequest[]
  extraRequests ExtraLeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

/// Employee leave balance per leave type per year
model LeaveBalance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  leaveTypeId    String    @map("leave_type_id") @db.Uuid
  year           Int
  /// Full-year entitlement (prorated from joining); monthly types accrue towards it
  allocated      Float     @default(0)
  carriedForward Float     @default(0) @map("carried_forward")
  /// Sum of manual adjustments (see leave_balance_adjustments)
  adjusted       Float     @default(0)
  usedDays       Float     @default(0) @map("used_days")
  pendingDays    Float     @default(0) @map("pending_days")
  /// How far below 0 HR lets this person go this year (sum of LEND adjustments)
  lendLimit      Float     @default(0) @map("lend_limit")
  /// Owed from earlier years that couldn't be taken back yet (rolls into the next year)
  owedLeft       Float     @default(0) @map("owed_left")
  /// Written when the year is closed (the ledger shows them later)
  carriedOut     Float?    @map("carried_out")
  lapsed         Float?
  owedOut        Float?    @map("owed_out")
  closedAt       DateTime? @map("closed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee    Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  adjustments LeaveBalanceAdjustment[]

  @@unique([companyId, employeeId, leaveTypeId, year])
  @@index([companyId, employeeId])
  @@map("leave_balances")
}

/// Manual balance changes by HR (audit trail)
model LeaveBalanceAdjustment {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  balanceId    String              @map("balance_id") @db.Uuid
  kind         LeaveAdjustmentKind @default(CORRECTION)
  /// Change to the balance (0 for LEND)
  days         Float
  /// LEND: how far below 0 this lets the person go
  lendLimit    Float?              @map("lend_limit")
  /// TAKEN_BACK / WAIVED: the owed days this entry settles
  owedDays     Float?              @map("owed_days")
  /// The "ask for more days" request this answered
  requestId    String?             @map("request_id") @db.Uuid
  reason       String
  adjustedById String?             @map("adjusted_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")

  balance    LeaveBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  adjustedBy User?        @relation("LeaveAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)

  @@index([balanceId])
  @@map("leave_balance_adjustments")
}

/// Named people added to (INCLUDE) or kept out of (EXCLUDE) a leave type's rules
model LeaveTypeMember {
  leaveTypeId String          @map("leave_type_id") @db.Uuid
  employeeId  String          @map("employee_id") @db.Uuid
  mode        LeaveMemberMode

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([leaveTypeId, employeeId])
  @@index([employeeId])
  @@map("leave_type_members")
}

/// HR gives one person days of a GRANT_ONLY type for a period (not tied to a calendar year)
model LeaveGrant {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  employeeId   String           @map("employee_id") @db.Uuid
  leaveTypeId  String           @map("leave_type_id") @db.Uuid
  days         Float
  validFrom    DateTime         @map("valid_from") @db.Date
  /// Days not used by then lapse (HR can extend)
  validTo      DateTime         @map("valid_to") @db.Date
  reason       String
  status       LeaveGrantStatus @default(ACTIVE)
  documentKey  String?          @map("document_key")
  documentName String?          @map("document_name")
  documentMime String?          @map("document_mime")
  documentSize Int?             @map("document_size")
  grantedById  String?          @map("granted_by_id") @db.Uuid
  /// The employee's request this grant answered
  requestId    String?          @unique @map("request_id") @db.Uuid
  /// Ending-soon reminder sent for this validTo
  remindedFor  DateTime?        @map("reminded_for") @db.Date
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  request   LeaveGrantRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  events    LeaveGrantEvent[]
  leaves    LeaveRequest[]

  @@index([companyId, employeeId])
  @@index([companyId, leaveTypeId])
  @@map("leave_grants")
}

/// History of a grant: created, extended, shortened, revoked
model LeaveGrantEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantId   String    @map("grant_id") @db.Uuid
  /// CREATED | CHANGED | REVOKED
  kind      String
  days      Float?
  validTo   DateTime? @map("valid_to") @db.Date
  note      String?
  byId      String?   @map("by_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  grant LeaveGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("leave_grant_events")
}

/// An employee asks HR for a GRANT_ONLY type (e.g. maternity), usually with a document
model LeaveGrantRequest {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String                  @map("company_id") @db.Uuid
  employeeId   String                  @map("employee_id") @db.Uuid
  leaveTypeId  String                  @map("leave_type_id") @db.Uuid
  /// Expected dates
  fromDate     DateTime                @map("from_date") @db.Date
  toDate       DateTime                @map("to_date") @db.Date
  note         String
  status       LeaveGrantRequestStatus @default(PENDING)
  documentKey  String?                 @map("document_key")
  documentName String?                 @map("document_name")
  documentMime String?                 @map("document_mime")
  documentSize Int?                    @map("document_size")
  decidedById  String?                 @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?               @map("decided_at")
  decisionNote String?                 @map("decision_note")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  grant     LeaveGrant?

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@map("leave_grant_requests")
}

/// "Ask HR for more days" — the balance ran out; HR lends (go below 0) or gives extra
model ExtraLeaveRequest {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  employeeId   String           @map("employee_id") @db.Uuid
  leaveTypeId  String           @map("leave_type_id") @db.Uuid
  year         Int
  /// How many more days they need
  days         Float
  /// The leave they were trying to book (optional)
  startDate    DateTime?        @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  reason       String
  status       ExtraLeaveStatus @default(PENDING)
  /// Days lent / given (may differ from what was asked)
  decidedDays  Float?           @map("decided_days")
  decidedById  String?          @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?        @map("decided_at")
  decisionNote String?          @map("decision_note")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@map("extra_leave_requests")
}

/// Leave request submitted by an employee
model LeaveRequest {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  employeeId           String          @map("employee_id") @db.Uuid
  leaveTypeId          String          @map("leave_type_id") @db.Uuid
  startDate            DateTime        @map("start_date") @db.Date
  endDate              DateTime        @map("end_date") @db.Date
  /// Single-day requests only
  halfDay              HalfDaySession? @map("half_day")
  totalDays            Float           @map("total_days")
  reason               String
  status               LeaveStatus     @default(PENDING)
  /// Level waiting for a decision (1-based)
  currentLevel         Int             @default(1) @map("current_level")
  requiredLevels       Int             @default(1) @map("required_levels")
  decidedAt            DateTime?       @map("decided_at")
  cancelledAt          DateTime?       @map("cancelled_at")
  cancelledById        String?         @map("cancelled_by_id") @db.Uuid
  cancelReason         String?         @map("cancel_reason")
  /// Supporting document (e.g. doctor's note)
  documentKey          String?         @map("document_key")
  documentName         String?         @map("document_name")
  documentMime         String?         @map("document_mime")
  documentSize         Int?            @map("document_size")
  /// An approver asked a question that the employee hasn't answered yet (the asker's user id)
  questionOpenById     String?         @map("question_open_by_id") @db.Uuid
  /// Approved leave that has started: the person asked to cancel it (cleared once decided)
  cancelRequestedAt    DateTime?       @map("cancel_requested_at")
  cancelRequestReason  String?         @map("cancel_request_reason")
  /// Came back early: the last day actually taken (null = cancel all of it)
  cancelRequestLastDay DateTime?       @map("cancel_request_last_day") @db.Date
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  /// The grant this leave uses (GRANT_ONLY types)
  leaveGrantId String? @map("leave_grant_id") @db.Uuid

  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  grant     LeaveGrant?     @relation(fields: [leaveGrantId], references: [id], onDelete: SetNull)
  approvals LeaveApproval[]
  comments  LeaveComment[]

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@index([companyId, startDate, endDate])
  @@map("leave_requests")
}

/// Approval action at each level
model LeaveApproval {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveRequestId String              @map("leave_request_id") @db.Uuid
  level          Int
  /// First approver of the pool (display); null = only company-wide approvers (HR)
  approverId     String?             @map("approver_id") @db.Uuid
  /// Everyone who may decide this level (team leads, PMs, line manager…)
  approverIds    String[]            @default([]) @map("approver_ids") @db.Uuid
  /// Why these people, e.g. "Team lead · Apollo"
  label          String?
  status         LeaveApprovalStatus @default(PENDING)
  /// Who actually decided (approver, their delegate, or a company-wide approver)
  actedById      String?             @map("acted_by_id") @db.Uuid
  /// Set when the decision was made while covering for the approver
  onBehalfOfId   String?             @map("on_behalf_of_id") @db.Uuid
  comments       String?
  actedAt        DateTime?           @map("acted_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver     User?        @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  actedBy      User?        @relation("LeaveActedBy", fields: [actedById], references: [id], onDelete: SetNull)
  onBehalfOf   User?        @relation("LeaveOnBehalfOf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)

  @@unique([leaveRequestId, level])
  @@index([approverId, status])
  @@map("leave_approvals")
}

// ─────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────

model AttendanceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  date           DateTime         @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  workingMinutes Int?             @map("working_minutes")
  status         AttendanceStatus @default(PRESENT)
  isManualEntry  Boolean          @default(false) @map("is_manual_entry")
  /// Minutes after shift start + grace (null when on time / not checked in)
  lateMinutes    Int?             @map("late_minutes")
  /// WEB | REGULARISED | ADMIN
  checkInSource  String?          @map("check_in_source")
  checkOutSource String?          @map("check_out_source")
  checkInIp      String?          @map("check_in_ip")
  checkOutIp     String?          @map("check_out_ip")
  notes          String?
  /// Check-in sessions today (each check-in starts one)
  sessions       Int              @default(0)
  /// Time between sessions (checked out, then in again)
  breakMinutes   Int?             @map("break_minutes")
  /// Start of the session still running (null when checked out)
  openSince      DateTime?        @map("open_since")
  /// Last check-out was before a full day
  earlyCheckout  Boolean          @default(false) @map("early_checkout")
  /// The check-out was added automatically (forgotten check-out)
  autoClosed     Boolean          @default(false) @map("auto_closed")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id])
  punches  AttendancePunch[]

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@index([companyId, employeeId])
  @@map("attendance_records")
}

enum PunchKind {
  IN
  OUT
}

/// Every check-in and check-out tap, kept as a trail. WEB today; MOBILE and
/// GATE (card readers at the entrance) later — gate taps let us spot
/// tailgating (checked in but never tapped in) and late arrivals.
model AttendancePunch {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  recordId   String    @map("record_id") @db.Uuid
  /// The day the tap counts towards (a night shift's check-out belongs to the day it started)
  date       DateTime  @db.Date
  kind       PunchKind
  at         DateTime
  /// WEB | MOBILE | GATE | ADMIN | REGULARISED
  source     String    @default("WEB")
  deviceId   String?   @map("device_id")
  ip         String?
  /// Reason given when checking out before a full day
  note       String?
  early      Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, date])
  @@index([recordId])
  @@map("attendance_punches")
}

/// Company holidays — affects leave deduction and attendance
/// Company-wide attendance rules (times are wall-clock in CompanySettings.timezone)
model AttendancePolicy {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String   @unique @map("company_id") @db.Uuid
  /// Working weekdays, 0 = Sunday … 6 = Saturday
  workDays                 Int[]    @default([1, 2, 3, 4, 5]) @map("work_days")
  /// "HH:mm"
  shiftStart               String   @default("09:30") @map("shift_start")
  shiftEnd                 String   @default("18:30") @map("shift_end")
  graceMinutes             Int      @default(15) @map("grace_minutes")
  /// Worked minutes for a half day / a full day
  halfDayMinutes           Int      @default(240) @map("half_day_minutes")
  fullDayMinutes           Int      @default(480) @map("full_day_minutes")
  /// How many days back an employee may request a correction
  regularisationWindowDays Int      @default(30) @map("regularisation_window_days")
  webCheckInEnabled        Boolean  @default(true) @map("web_check_in_enabled")
  /// Tell lead / manager / HR when someone asks for more corrections than this in a month
  correctionAlertAt        Int      @default(8) @map("correction_alert_at")
  /// Tell the line manager after this many late arrivals in a month (null = off)
  lateAlertAt              Int?     @map("late_alert_at")
  /// Close a forgotten check-out this many minutes after the shift ends (null = off)
  autoCloseAfterMinutes    Int?     @map("auto_close_after_minutes")
  /// How many optional holidays each person may pick per year
  optionalHolidayLimit     Int      @default(5) @map("optional_holiday_limit")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("attendance_policies")
}

/// Extra working hours besides the company's general shift (e.g. Night); people are assigned to one
model WorkShift {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  /// "HH:mm"; an end before the start runs past midnight
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  color     String   @default("#7C3AED")
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("work_shifts")
}

/// Attendance correction request ("regularisation"), approved by the manager / HR
model AttendanceRegularisation {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String               @map("company_id") @db.Uuid
  employeeId   String               @map("employee_id") @db.Uuid
  date         DateTime             @db.Date
  checkIn      DateTime             @map("check_in")
  checkOut     DateTime?            @map("check_out")
  reason       String
  status       RegularisationStatus @default(PENDING)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  /// Set when the reviewer acted while covering for someone (approval delegation)
  onBehalfOfId String?              @map("on_behalf_of_id") @db.Uuid
  /// Project / line approvers worked out when the request was made
  approverIds  String[]             @default([]) @map("approver_ids") @db.Uuid
  reviewedAt   DateTime?            @map("reviewed_at")
  reviewNote   String?              @map("review_note")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("CorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  onBehalfOf User?    @relation("CorrectionOnBehalfOf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, employeeId, date])
  @@map("attendance_regularisations")
}

model PublicHoliday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  date        DateTime @db.Date
  isOptional  Boolean  @default(false) @map("is_optional")
  year        Int
  /// Office locations it applies to; empty = everyone
  locationIds String[] @default([]) @map("location_ids") @db.Uuid

  company Company         @relation(fields: [companyId], references: [id])
  choices HolidayChoice[]

  @@unique([companyId, date])
  @@index([companyId, year])
  @@map("public_holidays")
}

/// An optional holiday a person picked (counts as a holiday for them only)
model HolidayChoice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  holidayId  String   @map("holiday_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  holiday  PublicHoliday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([employeeId, holidayId])
  @@index([companyId, employeeId])
  @@map("holiday_choices")
}

// ─────────────────────────────────────────────────────────────
// IMPORT PIPELINE
// ─────────────────────────────────────────────────────────────

/// Tracks bulk import jobs (8-stage pipeline)
model ImportJob {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  entityType    ImportEntityType @map("entity_type")
  status        ImportJobStatus  @default(UPLOADED)
  fileName      String           @map("file_name")
  fileKey       String?          @map("file_key") // MinIO object key
  totalRows     Int?             @map("total_rows")
  validRows     Int?             @map("valid_rows")
  invalidRows   Int?             @map("invalid_rows")
  processedRows Int?             @map("processed_rows")
  errorSummary  Json?            @map("error_summary")
  errorFileKey  String?          @map("error_file_key") // MinIO key for error report
  initiatedBy   String           @map("initiated_by") @db.Uuid
  confirmedAt   DateTime?        @map("confirmed_at")
  completedAt   DateTime?        @map("completed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("import_jobs")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG — Immutable
// ─────────────────────────────────────────────────────────────

/// Append-only audit trail — WHO did WHAT to WHICH resource WHEN and from WHERE
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String?  @map("company_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  /// AuditAction enum value stored as string for flexibility
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([companyId, action])
  @@index([companyId, resourceType, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// THEMING
// ─────────────────────────────────────────────────────────────

/// Custom theme saved in the platform theme library (built-in presets live in code).
/// `tokens` follows the ThemeTokens contract in @hrms/types.
model Theme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  tokens      Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("themes")
}

/// Platform-wide key/value settings (e.g. superAdminTheme, defaultCompanyTheme).
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────
// ACCESS CONTROL — plans, feature entitlements, org hierarchy
// ─────────────────────────────────────────────────────────────

/// Subscription plan: a bundle of catalog features + default limits
model Plan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String   @default("")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  /// Plan limits, e.g. { "maxEmployees": 50 } — null value = unlimited
  limits      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  features  PlanFeature[]
  companies Company[]

  @@map("plans")
}

model PlanFeature {
  planId     String @map("plan_id") @db.Uuid
  /// Catalog feature key, e.g. "time.leave"
  featureKey String @map("feature_key")
  /// e.g. { "maxEmployees": 50 } — null value = unlimited
  limits     Json?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
}

/// Per-company exception on top of the plan (force ON/OFF, custom limits, trials)
model CompanyFeature {
  companyId  String          @map("company_id") @db.Uuid
  featureKey String          @map("feature_key")
  mode       FeatureOverride
  limits     Json?
  reason     String?
  /// Override lapses after this moment (trials)
  expiresAt  DateTime?       @map("expires_at")
  setById    String?         @map("set_by") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, featureKey])
  @@map("company_features")
}

/// Company-defined ranks: e.g. Member < Team Lead < Manager < Director
model OrgLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  /// Higher = more senior
  rank      Int
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designations Designation[]

  @@unique([companyId, name])
  @@unique([companyId, rank])
  @@map("org_levels")
}

/// Closure table of reporting lines: one row per (manager, person at any depth below).
/// depth 0 = the employee themself. Maintained by HierarchyService.
model EmployeeHierarchy {
  companyId    String @map("company_id") @db.Uuid
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ancestor   Employee @relation("HierarchyAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Employee @relation("HierarchyDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@index([companyId])
  @@map("employee_hierarchy")
}

/// Closure table of the department tree (depth 0 = the department itself)
model DepartmentHierarchy {
  companyId    String @map("company_id") @db.Uuid
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ancestor   Department @relation("DeptAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Department @relation("DeptDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@index([companyId])
  @@map("department_hierarchy")
}

/// Temporary hand-over of approval permissions (e.g. while a manager is on leave).
/// The delegate approves with the DELEGATOR's reach (their team), only between the dates.
model ApprovalDelegation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  delegatorId String    @map("delegator_id") @db.Uuid
  delegateId  String    @map("delegate_id") @db.Uuid
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  reason      String?
  createdById String    @map("created_by") @db.Uuid
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by") @db.Uuid
  /// Which approvals are handed over (empty = all the delegator has)
  permissions String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  delegator User    @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate  User    @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([delegateId, endsAt])
  @@index([delegatorId, endsAt])
  @@index([companyId])
  @@map("approval_delegations")
}

/// In-app inbox item (also emailed when the user allows it)
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String?   @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// e.g. leave.submitted, leave.approved, attendance.missing_checkout
  type      String
  title     String
  body      String?
  /// App path to open, e.g. /app/leave/approvals
  link      String?
  /// Prevents duplicates (e.g. one reminder per user per day)
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  /// Email held back (quiet hours / daily summary) — sent later in a summary
  emailHeld Boolean   @default(false) @map("email_held")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A client / internal project. People are assigned through ProjectMember.
model Project {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  code               String
  name               String
  description        String?
  clientName         String?       @map("client_name")
  /// Set by the PMO: client (billable) or internal (investment)
  type               ProjectType   @default(INTERNAL)
  /// Card / timeline colour (#RRGGBB)
  color              String?
  status             ProjectStatus @default(ACTIVE)
  startDate          DateTime      @map("start_date") @db.Date
  endDate            DateTime?     @map("end_date") @db.Date
  createdById        String?       @map("created_by_id") @db.Uuid
  /// Set by the PMO: oversees the PM (resource requests go Lead → PM → Delivery Director → PMO)
  deliveryDirectorId String?       @map("delivery_director_id") @db.Uuid
  /// Technologies used here (kept by the project's leads)
  techStack          String[]      @default([]) @map("tech_stack")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  company          Company            @relation(fields: [companyId], references: [id])
  members          ProjectMember[]
  timesheetEntries TimesheetEntry[]
  milestones       ProjectMilestone[]
  updates          ProjectUpdate[]
  openRoles        ProjectOpenRole[]
  events           ProjectEvent[]
  resourceRequests ResourceRequest[]
  deliveryDirector Employee?          @relation("ProjectDeliveryDirector", fields: [deliveryDirectorId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("projects")
}

/// Someone's assignment to a project: role, their team lead, allocation %.
/// An employee's overlapping allocations never exceed 100%.
model ProjectMember {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  employeeId     String      @map("employee_id") @db.Uuid
  role           ProjectRole @default(MEMBER)
  /// Client projects: false for people the client doesn't pay for (shadows, trainees)
  billed         Boolean     @default(true)
  /// Members only: their team lead in this project (a TEAM_LEAD of the same project)
  leadEmployeeId String?     @map("lead_employee_id") @db.Uuid
  /// 1–100
  allocation     Int
  /// The project needs this person to work nights: they may stay checked in past midnight
  nightShift     Boolean     @default(false) @map("night_shift")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date") @db.Date
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee  @relation("ProjectMemberEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  lead     Employee? @relation("ProjectMemberLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@index([projectId])
  @@map("project_members")
}

/// A checkpoint on a project's road (UAT sign-off, go-live…)
model ProjectMilestone {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  title           String
  dueDate         DateTime  @map("due_date") @db.Date
