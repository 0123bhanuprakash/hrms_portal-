# ============================================================
# HRMS Portal API — environment template
# Copy to apps/api/.env and fill in the values. NEVER commit .env.
# Required: DATABASE_URL, DIRECT_URL, JWT_*, SUPER_ADMIN_*
# Everything else has a working default for local development.
# ============================================================

# ---- Database: local PostgreSQL (recommended for development) ----
# ~1 ms per query vs ~25–30 ms to Supabase. Install PostgreSQL, `create database hrms`,
# then `pnpm db:setup` (or restore a pg_dump of the hrms schema). URL-encode the password.
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/hrms?schema=hrms"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/hrms?schema=hrms"

# ---- Database (Supabase Postgres) ----
# Supabase dashboard → Connect. Replace [YOUR-PASSWORD]; URL-encode special
# characters (@ → %40, ! → %21). ?schema=hrms keeps tables out of "public",
# which Supabase's Data API exposes.
#
# App traffic → TRANSACTION pooler (port 6543). Do NOT use the session pooler
# (5432) here: it allows only ~15 clients, and Prisma opens (CPU cores × 2 + 1)
# connections by default — requests then queue for seconds or fail with
# EMAXCONNSESSION. pgbouncer=true turns off prepared statements, which
# transaction pooling doesn't support.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?schema=hrms&pgbouncer=true&connection_limit=10"
# Used by `prisma migrate` (needs a session connection) → SESSION pooler, port 5432.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=hrms"

# ---- JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-to-another-random-string-of-at-least-32-chars"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Super Admin (created by: pnpm db:seed) ----
SUPER_ADMIN_EMAIL=superadmin@hrms.local
SUPER_ADMIN_PASSWORD="change-me"
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ---- App ----
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Email ----
# console = print to terminal + save .html to apps/api/.mail (no mail server needed)
EMAIL_PROVIDER=console
SMTP_FROM="HRMS Portal <noreply@hrms.local>"
# Gmail: needs 2-Step Verification + a 16-character App Password (Google Account → Security → App passwords)
# EMAIL_PROVIDER=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="HRMS Portal <you@gmail.com>"
# Any SMTP server (Mailpit, Workspace relay, SES SMTP…): STARTTLS on 587, SMTP_SECURE=true for 465
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM="HRMS Portal <noreply@yourdomain.com>"

# ---- File storage ----
# local = files saved in apps/api/uploads and served at http://localhost:4000/uploads
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3   (MinIO / AWS S3 / Supabase Storage)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=hrms-dev

# ---- Optional services (leave commented out to disable) ----
# Redis → enables the BullMQ email queue + Bull Board. Without it emails are sent inline.
# REDIS_URL=redis://127.0.0.1:6379
# Elasticsearch → used from Phase 2 (search)
# ELASTICSEARCH_URL=http://localhost:9200

# ── Personal data encryption ─────────────────────────────
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
# Employee documents (private, downloaded through the API only)
PRIVATE_FILES_DIR=private-files
