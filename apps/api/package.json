{
  "name": "@hrms/api",
  "version": "0.0.1",
  "private": true,
  "description": "HRMS Portal — NestJS Backend API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --entryFile apps/api/src/main",
    "start": "node dist/apps/api/src/main",
    "debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/run.js",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:studio": "prisma studio",
    "db:seed-demo": "node prisma/seed-demo.cjs",
    "db:seed-demo-avatars": "node prisma/seed-demo-avatars.cjs",
    "db:seed-demo-ui": "node prisma/seed-demo-ui.cjs",
    "postman": "node scripts/postman/build-postman.mjs",
    "db:seed-seedsai": "node --env-file=.env -r ts-node/register/transpile-only -r tsconfig-paths/register prisma/seedsai/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@bull-board/api": "^9.10.2",
    "@bull-board/express": "^9.10.2",
    "@hrms/types": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.5.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@hrms/config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^8.57.1",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
