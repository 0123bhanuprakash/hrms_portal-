# ============================================================
# HRMS Portal — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ============================================================

# ---- Database ----
DATABASE_URL="postgresql://hrms:hrms_password@localhost:5432/hrms_dev?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Elasticsearch ----
ELASTICSEARCH_URL="http://localhost:9200"

# ---- MinIO (S3-compatible file storage) ----
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="hrms_minio_user"
MINIO_SECRET_KEY="hrms_minio_password"
MINIO_BUCKET_NAME="hrms-dev"

# ---- JWT ----
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ---- Email ----
# Options: "mailpit" | "resend"
EMAIL_PROVIDER="mailpit"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="HRMS Portal <noreply@hrms.local>"

# Resend (production only)
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM="HRMS Portal <noreply@yourdomain.com>"

# ---- Super Admin (seed data) ----
SUPER_ADMIN_EMAIL="superadmin@hrms.local"
SUPER_ADMIN_PASSWORD="SuperAdmin@123"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"

# ---- App ----
NODE_ENV="development"
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# ---- Frontend (Next.js public vars — safe to expose to browser) ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
