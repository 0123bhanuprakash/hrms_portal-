{
  "name": "hrms-portal",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "turbo run clean",
    "infra:up": "pwsh -File scripts/infra-up.ps1",
    "infra:down": "pwsh -File scripts/infra-down.ps1",
    "infra:status": "pwsh -File scripts/infra-status.ps1",
    "infra:logs": "pwsh -File scripts/infra-logs.ps1",
    "infra:reset": "pwsh -File scripts/infra-reset.ps1"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "@types/node": "^22.15.3"
  }
}
