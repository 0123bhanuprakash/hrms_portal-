{
  "name": "hrms-portal",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "turbo run clean",
    "db:setup": "pnpm --filter @hrms/api db:setup",
    "db:migrate": "pnpm --filter @hrms/api db:migrate",
    "db:seed": "pnpm --filter @hrms/api db:seed",
    "db:studio": "pnpm --filter @hrms/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "@types/node": "^22.15.3"
  }
}
